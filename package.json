{
  "name": "daymark",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node .neander/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local .neander/migrate.mjs",
    "db:up": "docker compose -p thicket-cedar-coral-dev -f compose.dev.yaml up -d --wait",
    "db:down": "docker compose -p thicket-cedar-coral-dev -f compose.dev.yaml down",
    "db:seed": "node --env-file-if-exists=.env.local .neander/seed.mjs",
    "test": "node --test scripts/template.test.mjs",
    "test:template": "node scripts/verify-template.mjs && node scripts/test-milestone-browser.mjs",
    "test:policy": "python3 scripts/check_repository.py",
    "verify": "pnpm run check && pnpm run test && pnpm run test:policy && pnpm run build",
    "test:production": "node scripts/verify-template.mjs && node scripts/test-milestone-browser.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-scheduler": "3.1175.0",
    "@aws-sdk/client-sesv2": "3.1175.0",
    "@google-cloud/storage": "9.0.0",
    "@next/env": "16.4.6",
    "drizzle-orm": "0.45.2",
    "firebase": "13.4.0",
    "firebase-admin": "14.5.1",
    "next": "16.4.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "firebase-tools": "15.37.0",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
